# Top-level Spectrum credentials (from your Photon dashboard).
# (PROJECT_ID / PROJECT_SECRET are also accepted.)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Which providers to run: imessage, telegram (comma separated).
SPECTRUM_PROVIDERS=imessage

# Telegram bot token (from @BotFather). Only needed if telegram is in SPECTRUM_PROVIDERS.
TELEGRAM_BOT_TOKEN=

# ElevenLabs (keep on the backend, never on the phone).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# OpenRouter: any model slug from openrouter.ai/models, one per job.
OPENROUTER_API_KEY=
MODEL_CLASSIFY=anthropic/claude-haiku-4.5
MODEL_ANSWER=anthropic/claude-haiku-4.5
MODEL_SHORTEN=anthropic/claude-haiku-4.5

# App
PORT=8787
DRIVER_NAME=Alex
CONTACTS_PATH=contacts.json

# Postgres for the risk engine REST API. Unset = API disabled.
# Tiger Data service driver-guardian-dev (aorxj58l39). The password is not in the URL: node-postgres
# reads it from ~/.pgpass, which `tiger` writes (`tiger config set password_storage pgpass`).
# Or append it yourself: `tiger service get aorxj58l39 --with-password`.
# uselibpqcompat=true makes sslmode=require mean "encrypt" as in libpq. Without it pg verifies the
# chain and fails with SELF_SIGNED_CERT_IN_CHAIN.
DATABASE_URL=postgresql://tsdbadmin@aorxj58l39.twi6g9dk4i.tsdb.cloud.timescale.com:34252/tsdb?sslmode=require&uselibpqcompat=true

# No network or credentials needed: FAKE_DB=1 runs the risk API on an in-process Postgres (PGlite) with the
# real schema, the seeded config tables and 12 generated trips (3 drivers: alex, sam, jo). It is also the
# automatic fallback when DATABASE_URL is set but unreachable. FAKE_DB_DIR=./data/fake persists it to disk.
# Same as `npm run dev:fake`. Inspect it with `npm run seed:fake`.
FAKE_DB=
FAKE_DB_DIR=

# Tiger Data (Postgres + TimescaleDB) for adaptive recommendations (bandit). Unset = off. Needs DATABASE_URL too.
# Set it to the same URL as DATABASE_URL: they then share one connection pool. A different URL still works but
# the bandit reads windows from DATABASE_URL, so the two would be split across databases.
# Tiger Cloud's certificate isn't in Node's trust store: with sslmode=require you get "self-signed certificate in
# certificate chain". Either trust the CA (NODE_EXTRA_CA_CERTS=/path/to/tiger-ca.pem) or use sslmode=no-verify
# (encrypted but not authenticated). Check the instance with: npm run smoke:tiger
TIGER_DATABASE_URL=postgres://tsdbadmin:i83ed4shknvxtbn9@m2jhl99tjd.twi6g9dk4i.tsdb.cloud.timescale.com:39854/tsdb

# ElevenLabs voice used for the family_voice_warning intervention. Unset = never offered.
ELEVENLABS_FAMILY_VOICE_ID=
