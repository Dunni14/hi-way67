# Top-level Spectrum credentials (from your Photon dashboard).
# (PROJECT_ID / PROJECT_SECRET are also accepted.)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Which providers to run: imessage, telegram (comma separated).
SPECTRUM_PROVIDERS=imessage

# Telegram bot token (from @BotFather). Only needed if telegram is in SPECTRUM_PROVIDERS.
TELEGRAM_BOT_TOKEN=

# ElevenLabs (keep on the backend, never on the phone).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# OpenRouter: any model slug from openrouter.ai/models, one per job.
OPENROUTER_API_KEY=
MODEL_CLASSIFY=anthropic/claude-haiku-4.5
MODEL_ANSWER=anthropic/claude-haiku-4.5
MODEL_SHORTEN=anthropic/claude-haiku-4.5

# App
PORT=8787
DRIVER_NAME=Alex
CONTACTS_PATH=contacts.json

# Postgres for the risk engine REST API (Tiger Data / Timescale works). Unset = API disabled.
DATABASE_URL=

# Tiger Data (Postgres + TimescaleDB) for adaptive recommendations (bandit). Unset = off. Needs DATABASE_URL too.
TIGER_DATABASE_URL=
