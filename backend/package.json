    "test": "tsx --test src/risk/*.test.ts"
  },
  "dependencies": {
    "@spectrum-ts/imessage": "^12.10.1",
    "@spectrum-ts/telegram": "^12.10.1",
    "spectrum-ts": "^12.10.1",
