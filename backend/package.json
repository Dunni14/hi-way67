{
  "name": "mhacks-auto-ai",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "smoke:tts": "tsx --env-file-if-exists=.env src/dev/smokeTts.ts",
    "fake-phone": "tsx --env-file-if-exists=.env src/dev/fakePhone.ts",
