<?xml version="1.0" encoding="utf-8"?>
<!-- Zones top to bottom: header, map (takes the leftover space), status grid, bottom nav. No page scroll. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/driveRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/drive_bg"
    android:orientation="vertical"
    android:padding="@dimen/drive_screen_padding">

    <!-- Header: current speed | status pill | speed limit -->
    <LinearLayout
        android:id="@+id/driveHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/drive_header_min_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/speedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--"
                android:textColor="@color/drive_great"
                android:textSize="@dimen/drive_text_speed"
                android:textStyle="bold" />

            <TextView
                style="@style/Drive.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drive_current_speed" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/avatarText"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/drive_avatar_bg"
                android:gravity="center"
                android:text="D"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/drive_pill_bg"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/pillTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/drive_trip_no_gps"
                    android:textColor="@color/drive_label"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pillSubtitle"
                    style="@style/Drive.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/drive_trip_monitoring" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/limitCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                app:cardBackgroundColor="@color/drive_card"
                app:cardCornerRadius="@dimen/drive_card_radius"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/limitText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/drive_no_limit"
                        android:textColor="@color/drive_label"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/limitFallbackDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/drive_dot_bg"
                        android:contentDescription="@string/drive_limit_fallback_desc"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Drive.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/drive_speed_limit" />
        </LinearLayout>
    </LinearLayout>

    <!-- Map box: takes the leftover height. The MapView is added in code so a missing token cannot crash inflation. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/drive_gap"
        android:layout_weight="1"
        android:minHeight="@dimen/drive_map_min_height"
        app:cardBackgroundColor="@color/drive_card"
        app:cardCornerRadius="@dimen/drive_map_radius"
        app:cardElevation="0dp">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/mapError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/drive_map_no_token"
            android:textColor="@color/drive_label"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Slot for anything drawn over the map: alert banner, recenter button, tier badge. -->
        <FrameLayout
            android:id="@+id/mapOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/alertBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/drive_banner_bg"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Status grid: two boxes per row, scrolls only if it would push the map under its minimum height. -->
    <com.example.coolvitals.drive.MaxHeightScrollView
        android:id="@+id/gridScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/drive_gap"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/statusGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.example.coolvitals.drive.MaxHeightScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/drive_nav_height"
        android:layout_marginTop="@dimen/drive_gap"
        app:itemIconTint="@color/drive_icon"
        app:itemTextColor="@color/drive_label"
        app:menu="@menu/drive_nav" />
</LinearLayout>
